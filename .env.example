# Azure OpenAI / Azure AI Agent credentials (required)
# Set AZURE_OPENAI_ENDPOINT to your Azure AI Agent project endpoint, e.g.:
#   https://conductor-agent.services.ai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Optional – defaults to 2025-01-01-preview; see https://learn.microsoft.com/azure/ai-services/openai/api-version-deprecation
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure AI Agent – Ocp-Apim-Subscription-Key sent on every outgoing agent request (optional)
# Required when your agent endpoint is fronted by Azure API Management
# If set, this key is also used as the api-key fallback when AZURE_OPENAI_API_KEY is absent
AZURE_AGENT_SUBSCRIPTION_KEY=your-apim-subscription-key-here

# Incoming request authentication (optional)
# When set, every POST /api/v1/query request must include:
#   Ocp-Apim-Subscription-Key: <value>
# Leave unset (or empty) to disable incoming key validation.
CONDUCTOR_SUBSCRIPTION_KEY=your-conductor-subscription-key-here

# Optional – comma-separated list of allowed CORS origins; defaults to * (all origins)
# In production, restrict this to your web app's origin, e.g.: https://app.hobbyiq.com
ALLOWED_ORIGINS=*
